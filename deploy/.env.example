# Copy this file to `.env` next to docker-compose.prod.yml and fill in real
# values. `docker compose --env-file .env ...` will read it on startup.
#
# DO NOT commit the real `.env` — it is listed in deploy/.gitignore.

# Postgres superuser password for the `zerobudget` role. Used by both the
# `db` service (to initialise the cluster) and by the `app` service (via
# DATABASE_URL).
POSTGRES_PASSWORD=change-me

# HMAC secret used to sign JWT access tokens. Must be at least 32 characters.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-at-least-32-characters-long-please

# Comma-separated list of Origin headers the API will accept for CORS.
# Set this to whatever host serves the SPA (or leave as localhost for a
# LAN-only setup where the SPA is baked into the same container).
CORS_ORIGINS=http://localhost:8000
