# Copy this file to `.env` next to docker-compose.prod.yml and fill in real
# values. `docker compose --env-file .env ...` will read it on startup.
#
# DO NOT commit the real `.env` — it is listed in deploy/.gitignore.

# Postgres superuser password for the `zerobudget` role. Used by both the
# `db` service (to initialise the cluster) and by the `app` service (via
# DATABASE_URL).
POSTGRES_PASSWORD=change-me

# HMAC secret used to sign JWT access tokens. Must be at least 32 characters.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-at-least-32-characters-long-please

# Comma-separated list of Origin headers the API will accept for CORS.
# Set this to whatever host serves the SPA (or leave as localhost for a
# LAN-only setup where the SPA is baked into the same container).
CORS_ORIGINS=http://localhost:8000

# --- Plaid bank linking (optional) ---
# Leave these blank to disable the feature; the app keeps working and the
# "Link bank account" button just returns a 503 until they are filled in.
# Get credentials from https://dashboard.plaid.com.
PLAID_CLIENT_ID=
PLAID_SECRET=
# `sandbox` for test credentials (user_good / pass_good), `production` for
# real banks. Free Plaid tier only covers sandbox + a limited development env.
PLAID_ENV=sandbox
# Plaid coverage countries. Default is the EUR zone (ZeroBudget is EUR-only);
# trim to just your country if you prefer a shorter institution picker.
PLAID_COUNTRY_CODES=IE,FR,DE,ES,NL,IT,BE,AT,PT
# Fernet key used to encrypt Plaid access tokens at rest in Postgres.
# Must be a urlsafe base64-encoded 32-byte key (44 chars ending in `=`).
# Generate one with:
#   openssl rand -base64 32 | tr '+/' '-_'
# Losing this key means stored access tokens become unreadable — back it up
# alongside JWT_SECRET.
PLAID_ENCRYPTION_KEY=
