# Copy this file to `.env` next to docker-compose.prod.yml and fill in real
# values. `docker compose --env-file .env ...` will read it on startup.
#
# DO NOT commit the real `.env` — it is listed in deploy/.gitignore.

# Postgres superuser password for the `zerobudget` role. Used by both the
# `db` service (to initialise the cluster) and by the `app` service (via
# DATABASE_URL).
POSTGRES_PASSWORD=change-me

# HMAC secret used to sign JWT access tokens. Must be at least 32 characters.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-at-least-32-characters-long-please

# Comma-separated list of Origin headers the API will accept for CORS.
# Set this to whatever host serves the SPA (or leave as localhost for a
# LAN-only setup where the SPA is baked into the same container).
CORS_ORIGINS=http://localhost:8000

# --- Enable Banking (PSD2) bank sync (optional) ---
# Leave these blank to disable the feature; the app keeps working and the
# "Connect bank" button just returns a 503 until they are filled in.
# Register an application at https://enablebanking.com/cp — that gives you
# the application id and lets you download the RS256 private key (PEM).
ENABLE_BANKING_APP_ID=
# Private key: either a path inside the container (mount it as a secret)...
ENABLE_BANKING_PRIVATE_KEY_PATH=
# ...or the PEM content inline (path wins when both are set).
ENABLE_BANKING_PRIVATE_KEY=
# Must exactly match a redirect URL registered for the app in the Enable
# Banking control panel. Points at the SPA's callback route.
ENABLE_BANKING_REDIRECT_URL=http://localhost:8000/banking/callback
# Countries shown in the bank picker. Default is the EUR zone plus FI (the
# sandbox "Mock ASPSP" is Finnish); trim to just your country if you prefer.
BANKING_COUNTRIES=IE,FR,DE,ES,NL,IT,BE,AT,PT,FI
# Fernet key used to encrypt Enable Banking session ids at rest in Postgres.
# Must be a urlsafe base64-encoded 32-byte key (44 chars ending in `=`).
# Generate one with:
#   openssl rand -base64 32 | tr '+/' '-_'
# Losing this key means stored sessions become unreadable — back it up
# alongside JWT_SECRET.
BANK_ENCRYPTION_KEY=

# --- Transaction sync quota ---
# Enable Banking's free tier caps API usage, so sync runs are limited to
# SYNC_MAX_PER_DAY per UTC day (one run syncs every connected bank).
# SYNC_MODE=manual: you press "Sync now", up to the daily limit.
# SYNC_MODE=auto:   the backend syncs on its own every 24h / SYNC_MAX_PER_DAY.
SYNC_MODE=manual
SYNC_MAX_PER_DAY=4
