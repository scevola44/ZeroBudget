{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "prerelease": false,
  "packages": {
    ".": {}
  },
  "extra-files": [
    {
      "type": "generic",
      "path": "VERSION"
    },
    {
      "type": "json",
      "path": "frontend/package.json",
      "jsonpath": "$.version"
    },
    {
      "type": "json",
      "path": "frontend/package-lock.json",
      "jsonpath": "$.version"
    },
    {
      "type": "json",
      "path": "frontend/package-lock.json",
      "jsonpath": "$.packages[''].version"
    },
    {
      "type": "generic",
      "path": "backend/pyproject.toml"
    }
  ]
}
